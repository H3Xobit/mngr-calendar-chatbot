# --- Groq (LLM) ---
# Get an API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Google OAuth2 ---
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Application type: "Web application"
# Authorized redirect URI: http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- App ---
# Random string used to sign session cookies (any long random value)
SESSION_SECRET=change_me_to_a_long_random_string

# Server bind (defaults shown)
HOST=0.0.0.0
PORT=8000

# Local dev only: allow OAuth over http (Google requires this flag for non-https)
OAUTHLIB_INSECURE_TRANSPORT=1
